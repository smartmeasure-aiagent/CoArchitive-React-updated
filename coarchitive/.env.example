# Supabase connection for the admin content editor.
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Both values are safe to expose in the browser (the anon key is public by
# design; access is controlled by Row Level Security — see ADMIN_SETUP.md).
#
# After setting these locally, also add them in your host (Vercel ->
# Project -> Settings -> Environment Variables) and redeploy.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
